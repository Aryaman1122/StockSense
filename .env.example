# Local: docker compose up -d. Neon: use the *pooled* connection string, same region as the API host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inventory
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Production (frontend on a different site): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Local only: print OTPs to the console when RESEND_API_KEY is empty. Never enable in production.
OTP_DEV_ECHO=true
